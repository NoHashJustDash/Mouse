include_guard(GLOBAL)

if(MSVC)
  if(MSVC_VERSION LESS 1930)
    message(FATAL_ERROR "Mouse requires Visual Studio 2022 MSVC or newer")
  endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 13)
    message(FATAL_ERROR "Mouse requires GCC 13 or newer")
  endif()
elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 17)
    message(FATAL_ERROR "Mouse requires Clang 17 or newer")
  endif()
else()
  message(FATAL_ERROR "Unsupported C++ compiler: ${CMAKE_CXX_COMPILER_ID}")
endif()

function(mouse_target_options target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /WX /permissive- /utf-8 /Zc:__cplusplus)
    target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN)
  else()
    target_compile_options(${target} PRIVATE
      -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Werror)
    set_target_properties(${target} PROPERTIES
      BUILD_RPATH "$ORIGIN" INSTALL_RPATH "$ORIGIN")
  endif()

  if(MOUSE_SANITIZER)
    if(MSVC)
      message(FATAL_ERROR "Sanitizer presets require Clang on Linux")
    endif()
    if(MOUSE_SANITIZER STREQUAL "address")
      set(flags -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
    elseif(MOUSE_SANITIZER STREQUAL "thread")
      set(flags -fsanitize=thread -fno-omit-frame-pointer)
    else()
      message(FATAL_ERROR "Unsupported MOUSE_SANITIZER: ${MOUSE_SANITIZER}")
    endif()
    target_compile_options(${target} PRIVATE ${flags})
    target_link_options(${target} PRIVATE ${flags})
  endif()

  if(MOUSE_CLANG_TIDY)
    find_program(MOUSE_CLANG_TIDY_EXECUTABLE NAMES clang-tidy-19 clang-tidy REQUIRED)
    set_target_properties(${target} PROPERTIES CXX_CLANG_TIDY
      "${MOUSE_CLANG_TIDY_EXECUTABLE};--warnings-as-errors=*")
  endif()
endfunction()

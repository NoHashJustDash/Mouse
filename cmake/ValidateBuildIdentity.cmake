function(mouse_validate_version value)
  if(value STREQUAL "" OR value STREQUAL "unknown")
    return()
  endif()
  if(NOT value MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
    message(FATAL_ERROR "MOUSE_VERSION must be a SemVer version or unknown")
  endif()
  if(value MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+-([^+]+)")
    set(prerelease "${CMAKE_MATCH_1}")
    string(REPLACE "." ";" identifiers "${prerelease}")
    foreach(identifier IN LISTS identifiers)
      if(identifier MATCHES "^0[0-9]+$")
        message(FATAL_ERROR "MOUSE_VERSION numeric prerelease identifiers cannot have leading zeros")
      endif()
    endforeach()
  endif()
endfunction()

function(mouse_validate_hash value)
  if(value STREQUAL "" OR value STREQUAL "unknown")
    return()
  endif()
  string(REGEX REPLACE "-dirty$" "" hexadecimal "${value}")
  string(LENGTH "${hexadecimal}" length)
  if(NOT hexadecimal MATCHES "^[0-9a-fA-F]+$" OR length LESS 7 OR length GREATER 64)
    message(FATAL_ERROR "MOUSE_GIT_HASH must be 7-64 hexadecimal digits with optional -dirty, or unknown")
  endif()
endfunction()

{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.toolchain/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "VCPKG_TARGET_TRIPLET": "x64-windows" }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "VCPKG_TARGET_TRIPLET": "x64-windows" }
    },
    {
      "name": "windows-pext",
      "inherits": "windows-release",
      "cacheVariables": { "MOUSE_USE_PEXT": "ON" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux" }
    },
    {
      "name": "linux-gcc-release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_COMPILER": "g++-13" }
    },
    {
      "name": "linux-clang-asan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_CXX_COMPILER": "clang++-19",
        "MOUSE_SANITIZER": "address"
      }
    },
    {
      "name": "linux-clang-tsan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_CXX_COMPILER": "clang++-19",
        "MOUSE_SANITIZER": "thread"
      }
    },
    {
      "name": "linux-clang-release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_COMPILER": "clang++-19" }
    },
    {
      "name": "linux-clang-lint",
      "inherits": "linux-clang-release",
      "cacheVariables": { "MOUSE_CLANG_TIDY": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-pext", "configurePreset": "windows-pext" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan" },
    { "name": "linux-clang-tsan", "configurePreset": "linux-clang-tsan" },
    { "name": "linux-clang-lint", "configurePreset": "linux-clang-lint" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "filter": { "include": { "label": "cpu" } }, "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "filter": { "include": { "label": "cpu" } }, "output": { "outputOnFailure": true } },
    { "name": "windows-pext", "configurePreset": "windows-pext", "filter": { "include": { "label": "cpu" } }, "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "filter": { "include": { "label": "cpu" } }, "output": { "outputOnFailure": true } },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "filter": { "include": { "label": "cpu" } }, "output": { "outputOnFailure": true } },
    { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan", "filter": { "include": { "label": "cpu" } }, "output": { "outputOnFailure": true } },
    { "name": "linux-clang-tsan", "configurePreset": "linux-clang-tsan", "filter": { "include": { "label": "cpu" } }, "output": { "outputOnFailure": true } }
  ]
}

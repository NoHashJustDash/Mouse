if(NOT DEFINED MOUSE_PROGRAM)
  message(FATAL_ERROR "MOUSE_PROGRAM is required")
endif()
function(check_perft expected_status expected_text)
  execute_process(COMMAND "${MOUSE_PROGRAM}" ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  if(NOT status EQUAL expected_status OR NOT "${output}${error}" MATCHES "${expected_text}")
    message(FATAL_ERROR "perft CLI failed: args=${ARGN}, status=${status}, output=${output}${error}")
  endif()
endfunction()
check_perft(0 "nodes 8902" perft 3)
check_perft(0 "nodes 1" perft 0)
check_perft(0 "e2e4: 600.*nodes 8902" perft divide 3)
check_perft(0 "nodes 48" perft 1 --fen "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1")
check_perft(0 "nodes 20" perft 1 --chess960)
check_perft(2 "depth" perft -1)
check_perft(2 "depth" perft 129)
check_perft(2 "depth" perft 1x)
check_perft(2 "depth" perft)
check_perft(2 "Unknown" perft 1 --unexpected)
check_perft(2 "FEN" perft 1 --fen)
check_perft(2 "FEN" perft 1 --fen "invalid")
check_perft(2 "Duplicate" perft 1 --chess960 --chess960)
check_perft(2 "Duplicate" perft 1 --fen "invalid" --fen "invalid")
check_perft(2 "UCI_Chess960" perft divide 1 --fen "4k3/8/8/8/8/8/8/5K1R w H - 0 1")
check_perft(0 "f1g1: 1.*f1h1: 1" perft divide 1 --fen "4k3/8/8/8/8/8/8/5K1R w H - 0 1" --chess960)
check_perft(2 "UCI_Chess960" perft divide 1 --fen "4k3/8/8/8/8/8/8/6KR w H - 0 1")
check_perft(0 "g1h1: 1" perft divide 1 --fen "4k3/8/8/8/8/8/8/6KR w H - 0 1" --chess960)
check_perft(2 "FEN" perft 1 --fen "k3r3/8/8/8/1b5b/8/8/4K3 w - - 0 1")

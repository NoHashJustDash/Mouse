# Isolated copy/install regression. Text payloads stand in for runtime binaries;
# no compiler, runtime loading, GPU, or integrated project build is involved.
foreach(required IN ITEMS MOUSE_SOURCE_DIRECTORY MOUSE_TEST_DIRECTORY MOUSE_MAKE_PROGRAM)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef unique)
set(test_root "${MOUSE_TEST_DIRECTORY}/ort-packaging-${unique}")
set(project "${test_root}/project")
file(MAKE_DIRECTORY "${project}")
file(WRITE "${project}/CMakeLists.txt" [=[
# SPDX-License-Identifier: GPL-3.0-or-later
cmake_minimum_required(VERSION 3.28)
project(MouseOrtPackagingRegression LANGUAGES NONE)
# Only this test project overrides the target-platform variable. The production
# module receives its usual WIN32 branch on either host, without a product knob.
if(MOUSE_MOCK_PLATFORM STREQUAL "Windows")
  set(WIN32 TRUE)
elseif(MOUSE_MOCK_PLATFORM STREQUAL "Linux")
  set(WIN32 FALSE)
else()
  message(FATAL_ERROR "Unknown packaging test platform")
endif()
set(MOUSE_ORT_ROOT "${MOUSE_MOCK_SDK}" CACHE PATH "Mock ORT SDK" FORCE)
include("${MOUSE_SOURCE_DIRECTORY}/cmake/OnnxRuntime.cmake")
add_custom_target(packaging_consumer)
mouse_copy_ort_runtime(packaging_consumer)
# This is the same public runtime list consumed by the real project's install.
install(FILES ${MOUSE_ORT_RUNTIME_FILES} DESTINATION .)
]=])
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    string(JOIN " " command ${ARGN})
    message(FATAL_ERROR "Command failed (${result}): ${command}\n${output}\n${error}")
  endif()
endfunction()
function(assert_payload directory expected sdk)
  file(GLOB actual_files LIST_DIRECTORIES FALSE "${directory}/*onnxruntime*")
  set(actual_names)
  foreach(path IN LISTS actual_files)
    cmake_path(GET path FILENAME name)
    list(APPEND actual_names "${name}")
  endforeach()
  list(SORT actual_names)
  list(SORT expected)
  if(NOT "${actual_names}" STREQUAL "${expected}")
    message(FATAL_ERROR "Runtime payload mismatch at ${directory}\nExpected: ${expected}\nActual: ${actual_names}")
  endif()
  foreach(name IN LISTS expected)
    file(SHA256 "${sdk}/lib/${name}" source_hash)
    file(SHA256 "${directory}/${name}" payload_hash)
    if(NOT source_hash STREQUAL payload_hash)
      message(FATAL_ERROR "Runtime payload contents differ: ${directory}/${name}")
    endif()
  endforeach()
endfunction()
set(case_count 0)
function(verify_case platform variant with_core with_shared with_cuda with_tensorrt expected_error)
  set(directory "${test_root}/${platform}-${variant}")
  set(sdk "${directory}/sdk")
  set(binary "${directory}/build")
  set(installed "${directory}/installed")
  set(staged "${binary}")
  if(variant STREQUAL "gpu-relocated")
    set(staged "${binary}/relocated-bin")
  endif()
  file(MAKE_DIRECTORY "${sdk}/include" "${sdk}/lib")
  file(WRITE "${sdk}/include/onnxruntime_c_api.h" "// SPDX-License-Identifier: GPL-3.0-or-later\n// Test-only header existence fixture.\n")
  file(WRITE "${sdk}/VERSION_NUMBER" "1.22.0\n")
  if(platform STREQUAL "Windows")
    set(core "onnxruntime.dll")
    set(shared "onnxruntime_providers_shared.dll")
    set(cuda "onnxruntime_providers_cuda.dll")
    set(tensorrt "onnxruntime_providers_tensorrt.dll")
  else()
    set(core "libonnxruntime.so.1.22.0")
    set(shared "libonnxruntime_providers_shared.so")
    set(cuda "libonnxruntime_providers_cuda.so")
    set(tensorrt "libonnxruntime_providers_tensorrt.so")
  endif()
  set(expected)
  foreach(component IN ITEMS core shared cuda tensorrt)
    if(with_${component})
      set(name "${${component}}")
      file(WRITE "${sdk}/lib/${name}" "Mock ORT packaging payload: ${platform}/${variant}/${name}\n")
      list(APPEND expected "${name}")
    endif()
  endforeach()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${project}" -B "${binary}" -G Ninja
    "-DCMAKE_MAKE_PROGRAM=${MOUSE_MAKE_PROGRAM}"
    "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY=${staged}"
    "-DMOUSE_SOURCE_DIRECTORY=${MOUSE_SOURCE_DIRECTORY}"
    "-DMOUSE_MOCK_PLATFORM=${platform}" "-DMOUSE_MOCK_SDK=${sdk}"
    RESULT_VARIABLE configure_result OUTPUT_VARIABLE configure_output ERROR_VARIABLE configure_error)
  if(NOT expected_error STREQUAL "")
    if(configure_result EQUAL 0 OR NOT "${configure_output}${configure_error}" MATCHES "${expected_error}")
      message(FATAL_ERROR "Expected configuration failure '${expected_error}' for ${platform}/${variant}:\n${configure_output}\n${configure_error}")
    endif()
  else()
    if(NOT configure_result EQUAL 0)
      message(FATAL_ERROR "Packaging configure failed for ${platform}/${variant}:\n${configure_output}\n${configure_error}")
    endif()
    run("${CMAKE_COMMAND}" --build "${binary}" --target packaging_consumer)
    assert_payload("${staged}" "${expected}" "${sdk}")
    # Removing a copied provider/core must be repaired by the real always-run
    # staging target on the next otherwise-no-op build.
    list(GET expected -1 removed)
    file(REMOVE "${staged}/${removed}")
    run("${CMAKE_COMMAND}" --build "${binary}" --target packaging_consumer)
    assert_payload("${staged}" "${expected}" "${sdk}")
    run("${CMAKE_COMMAND}" --install "${binary}" --prefix "${installed}")
    assert_payload("${installed}" "${expected}" "${sdk}")
  endif()
  math(EXPR next_count "${case_count}+1")
  set(case_count "${next_count}" PARENT_SCOPE)
  message(STATUS "ORT packaging verified: ${platform}/${variant}")
endfunction()
# First case directly reproduces the reviewed missing Linux GPU providers.
verify_case(Linux gpu TRUE TRUE TRUE TRUE "")
foreach(platform IN ITEMS Linux Windows)
  if(platform STREQUAL "Windows")
    verify_case(Windows gpu TRUE TRUE TRUE TRUE "")
  endif()
  verify_case(${platform} cuda TRUE TRUE TRUE FALSE "")
  verify_case(${platform} tensorrt TRUE TRUE FALSE TRUE "")
  verify_case(${platform} cpu-shared TRUE TRUE FALSE FALSE "")
  verify_case(${platform} cpu-core TRUE FALSE FALSE FALSE "")
  verify_case(${platform} missing-core FALSE TRUE TRUE TRUE "Required ONNX Runtime library is missing")
  verify_case(${platform} cuda-without-shared TRUE FALSE TRUE FALSE "shared")
  verify_case(${platform} tensorrt-without-shared TRUE FALSE FALSE TRUE "shared")
endforeach()
verify_case(Linux gpu-relocated TRUE TRUE TRUE TRUE "")
verify_case(Windows gpu-relocated TRUE TRUE TRUE TRUE "")
message(STATUS "ORT_PACKAGING_RESULT cases=${case_count}; exact staging/install payloads and repair verified")

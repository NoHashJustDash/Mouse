if(NOT DEFINED MOUSE_PROGRAM OR NOT DEFINED MOUSE_FIXTURE_DIRECTORY)
  message(FATAL_ERROR "Mouse executable and metadata fixtures are required")
endif()
function(check expected pattern)
  execute_process(COMMAND "${MOUSE_PROGRAM}" describe-net ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT status EQUAL expected OR NOT "${output}${error}" MATCHES "${pattern}")
    message(FATAL_ERROR "describe-net expected ${expected}/${pattern}, got ${status}: ${output}${error}")
  endif()
endfunction()
check(0 "parameters: 1" "${MOUSE_FIXTURE_DIRECTORY}/valid.onnx")
check(1 "mouse.schema_version" "${MOUSE_FIXTURE_DIRECTORY}/missing-metadata.onnx")
check(1 "policy" "${MOUSE_FIXTURE_DIRECTORY}/wrong-policy-shape.onnx")
check(1 "float32" "${MOUSE_FIXTURE_DIRECTORY}/wrong-input-type.onnx")
check(1 "ONNX" "${MOUSE_FIXTURE_DIRECTORY}/not-onnx.bin")
check(1 "exist" "${MOUSE_FIXTURE_DIRECTORY}/missing.onnx")
check(2 "requires exactly one model path")
check(2 "requires exactly one model path" a b)
message(STATUS "ONNX inspection CLI conformance passed")

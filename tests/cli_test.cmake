if(NOT DEFINED MOUSE_PROGRAM OR NOT DEFINED MOUSE_CASE)
  message(FATAL_ERROR "MOUSE_PROGRAM and MOUSE_CASE are required")
endif()
set(program "${MOUSE_PROGRAM}")
if(MOUSE_CASE STREQUAL "missing" OR MOUSE_CASE STREQUAL "wrong")
  if(NOT DEFINED MOUSE_RUNTIME_FILENAME OR NOT DEFINED MOUSE_TEST_DIRECTORY)
    message(FATAL_ERROR "Isolated runtime test requires runtime name and directory")
  endif()
  set(test_directory "${MOUSE_TEST_DIRECTORY}/cli-${MOUSE_CASE}")
  file(MAKE_DIRECTORY "${test_directory}")
  get_filename_component(program_name "${MOUSE_PROGRAM}" NAME)
  file(COPY_FILE "${MOUSE_PROGRAM}" "${test_directory}/${program_name}" ONLY_IF_DIFFERENT)
  set(program "${test_directory}/${program_name}")
  if(MOUSE_CASE STREQUAL "wrong")
    file(COPY_FILE "${MOUSE_WRONG_RUNTIME}" "${test_directory}/${MOUSE_RUNTIME_FILENAME}" ONLY_IF_DIFFERENT)
  endif()
endif()
if(MOUSE_CASE STREQUAL "help")
  set(argument "--help")
elseif(MOUSE_CASE STREQUAL "invalid")
  set(argument "--unknown-mouse-option")
else()
  set(argument "--version")
endif()
execute_process(COMMAND "${program}" "${argument}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(MOUSE_CASE STREQUAL "version")
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Version failed (${status}): ${error}")
  endif()
  set(hash_pattern "[0-9a-fA-F]+(-dirty)?")
  if(MOUSE_ALLOW_UNKNOWN_IDENTITY)
    set(hash_pattern "(${hash_pattern}|unknown(-dirty)?)")
  endif()
  foreach(field IN ITEMS "Mouse " "git: ${hash_pattern}[\r\n]" "build: " "compiler: " "ONNX Runtime: 1\\.22\\.0")
    if(NOT output MATCHES "${field}")
      message(FATAL_ERROR "Version output lacks ${field}: ${output}")
    endif()
  endforeach()
elseif(MOUSE_CASE STREQUAL "help")
  if(NOT status EQUAL 0 OR NOT output MATCHES "--version" OR NOT output MATCHES "--help")
    message(FATAL_ERROR "Invalid help response (${status}): ${output}${error}")
  endif()
elseif(MOUSE_CASE STREQUAL "invalid")
  if(NOT status EQUAL 2 OR NOT error MATCHES "Unknown argument")
    message(FATAL_ERROR "Invalid argument must fail clearly: ${status} ${output}${error}")
  endif()
elseif(MOUSE_CASE STREQUAL "missing")
  if(NOT status EQUAL 1 OR NOT error MATCHES "Cannot load ONNX Runtime")
    message(FATAL_ERROR "Missing local runtime must fail: ${status} ${output}${error}")
  endif()
elseif(MOUSE_CASE STREQUAL "wrong")
  if(NOT status EQUAL 1 OR NOT error MATCHES "version mismatch: loaded 0.0.0.*required 1.22.0")
    message(FATAL_ERROR "Wrong runtime version must fail: ${status} ${output}${error}")
  endif()
else()
  message(FATAL_ERROR "Unknown CLI test case: ${MOUSE_CASE}")
endif()
message(STATUS "CLI ${MOUSE_CASE} verified: ${output}${error}")

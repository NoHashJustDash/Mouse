cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED MOUSE_PROGRAM OR NOT DEFINED MOUSE_FIXTURE_DIRECTORY)
  message(FATAL_ERROR "Search CLI test requires engine and fixtures")
endif()
function(search result budget_nodes)
  execute_process(COMMAND "${MOUSE_PROGRAM}" search
    --weights valid.onnx --backend cpu --precision fp32
    --deterministic --batch 4 --ram-limit-mb 16 --nodes "${budget_nodes}" ${ARGN}
    WORKING_DIRECTORY "${MOUSE_FIXTURE_DIRECTORY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Search command failed ${status}: ${error}\n${output}")
  endif()
  string(JSON schema GET "${output}" schema)
  string(JSON nodes GET "${output}" nodes)
  string(JSON charged GET "${output}" charged_bytes)
  string(JSON budget GET "${output}" budget_bytes)
  string(JSON provider GET "${output}" provider)
  string(JSON hash GET "${output}" model_sha256)
  file(SHA256 "${MOUSE_FIXTURE_DIRECTORY}/valid.onnx" expected_hash)
  if(NOT schema STREQUAL "MouseSearch1" OR nodes GREATER "${budget_nodes}" OR
     charged GREATER budget OR NOT provider STREQUAL "CPUExecutionProvider" OR
     NOT hash STREQUAL expected_hash)
    message(FATAL_ERROR "Search output contract mismatch: ${output}")
  endif()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()
function(expect_moves_left result expected)
  string(JSON value_type ERROR_VARIABLE key_error TYPE "${result}" moves_left_utility)
  if(key_error OR NOT value_type STREQUAL "BOOLEAN")
    message(FATAL_ERROR "Search must report a boolean moves_left_utility: ${key_error}/${result}")
  endif()
  string(JSON value GET "${result}" moves_left_utility)
  if((expected AND NOT value) OR (NOT expected AND value))
    message(FATAL_ERROR "Incorrect moves_left_utility selection: ${result}")
  endif()
endfunction()
search(first 37 --moves "e2e4 e7e5")
expect_moves_left("${first}" TRUE)
search(second 37 --moves "e2e4 e7e5")
foreach(key IN ITEMS nodes bestmove pv q draw input_sha256)
  string(JSON a GET "${first}" "${key}")
  string(JSON b GET "${second}" "${key}")
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "Deterministic search changed ${key}: ${a} / ${b}")
  endif()
endforeach()
string(JSON nodes GET "${first}" nodes)
string(JSON reason GET "${first}" stop_reason)
string(JSON fen GET "${first}" fen)
if(NOT nodes EQUAL 37 OR NOT reason STREQUAL "nodes")
  message(FATAL_ERROR "Exact node limit failed: ${first}")
endif()
search(without_moves_left 37 --moves "e2e4 e7e5" --no-moves-left-utility)
expect_moves_left("${without_moves_left}" FALSE)
string(JSON disabled_nodes GET "${without_moves_left}" nodes)
string(JSON disabled_reason GET "${without_moves_left}" stop_reason)
string(JSON disabled_identity GET "${without_moves_left}" input_sha256)
string(JSON enabled_identity GET "${first}" input_sha256)
if(NOT disabled_nodes EQUAL 37 OR NOT disabled_reason STREQUAL "nodes" OR
   NOT disabled_identity STREQUAL enabled_identity)
  message(FATAL_ERROR "Moves-left opt-out changed the node/input contract: ${without_moves_left}")
endif()
search(fen_root 37 --fen "${fen}")
string(JSON first_history GET "${first}" input_sha256)
string(JSON fen_history GET "${fen_root}" input_sha256)
if(first_history STREQUAL fen_history)
  message(FATAL_ERROR "Search identity lost explicit game history")
endif()
search(terminal 37 --fen "7k/6Q1/5K2/8/8/8/8/8 b - - 0 1")
string(JSON move_type TYPE "${terminal}" bestmove)
string(JSON reason GET "${terminal}" stop_reason)
string(JSON q GET "${terminal}" q)
if(NOT move_type STREQUAL "NULL" OR NOT reason STREQUAL "terminal" OR NOT q EQUAL -1)
  message(FATAL_ERROR "Checkmated root contract failed: ${terminal}")
endif()
function(reject pattern)
  execute_process(COMMAND "${MOUSE_PROGRAM}" search ${ARGN}
    WORKING_DIRECTORY "${MOUSE_FIXTURE_DIRECTORY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  if(status EQUAL 0 OR NOT output STREQUAL "" OR NOT error MATCHES "${pattern}")
    message(FATAL_ERROR "Expected search refusal /${pattern}/: ${status}/${output}/${error}")
  endif()
endfunction()
reject("--weights")
reject("Duplicate search option" --weights valid.onnx --backend cpu --precision fp32
  --no-moves-left-utility --no-moves-left-utility)
reject("FEN" --weights missing.onnx --backend cpu --precision fp32 --fen broken)
reject("move|Move" --weights missing.onnx --backend cpu --precision fp32 --moves e2e5)
reject("finite" --weights search-nonfinite.onnx --backend cpu --precision fp32 --nodes 37)
reject("ONNX artifact is not a regular file" --weights missing.onnx --backend cpu --precision fp32)

search(root_only 1)
string(JSON root_pv_length LENGTH "${root_only}" pv)
string(JSON root_best_type TYPE "${root_only}" bestmove)
string(JSON root_depth GET "${root_only}" depth)
string(JSON root_seldepth GET "${root_only}" seldepth)
if(NOT root_pv_length EQUAL 0 OR NOT root_best_type STREQUAL "STRING" OR
   NOT root_depth EQUAL 0 OR NOT root_seldepth EQUAL 0)
  message(FATAL_ERROR "Root-only search claimed an unevaluated PV: ${root_only}")
endif()


string(JSON root_count LENGTH "${first}" root_moves)
if(root_count LESS 1)
  message(FATAL_ERROR "Nonterminal search omitted root diagnostics")
endif()
set(child_visits 0)
math(EXPR last_root "${root_count}-1")
foreach(index RANGE "${last_root}")
  string(JSON visits GET "${first}" root_moves "${index}" visits)
  math(EXPR child_visits "${child_visits}+${visits}")
endforeach()
if(NOT child_visits EQUAL 36)
  message(FATAL_ERROR "Root diagnostics disagree with completed child visits: ${child_visits}")
endif()

message(STATUS "Search CLI identities, deterministic replay, legal-history and atomic failures passed")

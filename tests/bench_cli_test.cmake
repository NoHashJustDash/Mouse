cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED MOUSE_PROGRAM OR NOT DEFINED MOUSE_FIXTURE_DIRECTORY)
  message(FATAL_ERROR "Bench CLI test requires engine and fixtures")
endif()
execute_process(COMMAND "${MOUSE_PROGRAM}" bench --weights valid.onnx
  --backend cpu --precision fp32 --deterministic --no-moves-left-utility --batch 1 --ram-limit-mb 16 --nodes 1
  WORKING_DIRECTORY "${MOUSE_FIXTURE_DIRECTORY}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Bench command failed ${status}: ${error}\n${output}")
endif()
string(REPLACE "\r" "" output "${output}")
string(REGEX MATCH "\n(nodes 16 nps [0-9]+)\n$" signature "${output}")
if(NOT signature)
  message(FATAL_ERROR "Missing complete 16-case signature: ${output}")
endif()
string(REGEX REPLACE "\nnodes 16 nps [0-9]+\n$" "" report "${output}")
string(JSON schema GET "${report}" schema)
string(JSON corpus GET "${report}" corpus_sha256)
string(JSON count LENGTH "${report}" cases)
string(JSON nodes GET "${report}" nodes)
string(JSON provider GET "${report}" backend provider)
string(JSON model GET "${report}" backend model_sha256)
string(JSON mlh GET "${report}" configuration moves_left_utility)
if(mlh)
  message(FATAL_ERROR "Bench did not record the explicit MLH opt-out")
endif()
file(SHA256 "${MOUSE_FIXTURE_DIRECTORY}/valid.onnx" expected_model)
if(NOT schema STREQUAL "MouseBench1" OR NOT count EQUAL 16 OR NOT nodes EQUAL 16 OR
   NOT corpus STREQUAL "24f1e92c3d40b903dbbb6952b6bbfa330640342a45701471216a6db4ebdf4515" OR
   NOT provider STREQUAL "CPUExecutionProvider" OR NOT model STREQUAL expected_model)
  message(FATAL_ERROR "Bench identity/count contract failed: ${report}")
endif()
foreach(index RANGE 0 15)
  string(JSON case_nodes GET "${report}" cases "${index}" nodes)
  string(JSON inherited GET "${report}" cases "${index}" inherited_visits)
  string(JSON reason GET "${report}" cases "${index}" stop_reason)
  if(NOT case_nodes EQUAL 1 OR NOT inherited EQUAL 0 OR NOT reason STREQUAL "nodes")
    message(FATAL_ERROR "Bench case ${index} did not complete an independent budget")
  endif()
endforeach()
function(reject)
  execute_process(COMMAND "${MOUSE_PROGRAM}" bench ${ARGN}
    WORKING_DIRECTORY "${MOUSE_FIXTURE_DIRECTORY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  if(status EQUAL 0 OR NOT output STREQUAL "" OR NOT error MATCHES "Mouse error:")
    message(FATAL_ERROR "Expected atomic bench refusal: ${status}/${output}/${error}")
  endif()
endfunction()
reject()
reject(--weights valid.onnx --backend cpu --precision fp32 --nodes 0)
reject(--weights valid.onnx --backend cpu --precision fp32 --fen broken)
reject(--weights valid.onnx --backend cpu --precision fp32 --positions 1)
reject(--weights search-nonfinite.onnx --backend cpu --precision fp32 --nodes 2)
message(STATUS "Bench CLI:16 fresh CPU cases,signature and5 failure cases passed")
